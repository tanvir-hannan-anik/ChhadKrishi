# Copy to .env.local and fill in.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the app (e.g. https://chhadkrishi.com.bd in production)
BETTER_AUTH_URL=http://localhost:3000
# Production: a Postgres connection string (e.g. Neon). Unset = embedded PGlite in ./data (local dev only).
DATABASE_URL=

# --- AI (chat, photo analysis, care suggestions), server-side only ---
# The first key that is set decides the provider (or force one with CHHADKRISHI_AI_PROVIDER):
#   1. AI_GATEWAY_API_KEY            Vercel AI Gateway (on Vercel, OIDC works automatically)
#   2. GROQ_API_KEY                  Groq (free tier) — set in the Voice section below; also powers the mic
#   3. OPENROUTER_API_KEY            OpenRouter — uses free models by default, with automatic fallback
#   4. GOOGLE_GENERATIVE_AI_API_KEY  Google Gemini
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides. For OpenRouter a comma-separated list = primary, then fallbacks.
# CHHADKRISHI_CHAT_MODEL=google/gemma-4-31b-it:free,minimax/minimax-m3.1-flash:free
# CHHADKRISHI_VISION_MODEL=google/gemma-4-31b-it:free,minimax/minimax-m3.1-flash:free
# AI Garden Designer image editing (must accept a reference photo). Provider order for images:
# AI Gateway → Google → OpenRouter. Defaults: bfl/flux-kontext-pro (Gateway),
# gemini-3.1-flash-image-preview (Google), google/gemini-3.1-flash-image-preview (OpenRouter, paid).
# CHHADKRISHI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Force the image provider (gateway | google | openrouter), e.g. when a Google key has no image access.
# CHHADKRISHI_IMAGE_PROVIDER=openrouter
# Optional separate OpenRouter key used only for images (OpenRouter has no free image models).
# OPENROUTER_IMAGE_API_KEY=
# Development only: CHHADKRISHI_AI_FIXTURE=1 uses a labelled test model (ignored in production builds).

# Optional: YouTube Data API v3 key (server-side) for video cards with thumbnails below chat
# answers. Without it, the chat shows a "Search on YouTube" link card instead.
YOUTUBE_API_KEY=

# --- RAG reference library (optional), server-side only ---
# Supabase Postgres connection string (Project Settings -> Database -> Connection string,
# "Transaction pooler", port 6543). Holds the FAO book passages + pgvector embeddings.
# Load it with: npm run rag:ingest   (embeddings use AI_GATEWAY_API_KEY or OPENROUTER_API_KEY)
SUPABASE_DB_URL=
# CHHADKRISHI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b   (multilingual; stored at 1024 dimensions)

# --- Voice (optional), server-side only ---
# Chat mic: Whisper large-v3 on Groq (free tier at console.groq.com). Unset = the browser's own
# speech recognition (Chrome/Edge/Safari only).
GROQ_API_KEY=
# "Listen" button: official Azure Speech (free tier F0: 0.5M characters/month). Unset = the same
# Azure voices through the ML service below.
AZURE_SPEECH_KEY=
# e.g. southeastasia
AZURE_SPEECH_REGION=

# --- Self-hosted ML service (optional), server-side only — see ml-service/README.md ---
# Read-aloud (Microsoft neural voices via edge-tts) and OpenCV + YOLO photo measurements. Unset =
# no "Listen" button (unless AZURE_SPEECH_* is set), and photo analysis uses the vision LLM alone.
# (The chat mic is covered by GROQ_API_KEY above, or the browser.)
ML_SERVICE_URL=
# Long random string; the service must be started with the same ML_SERVICE_TOKEN.
ML_SERVICE_TOKEN=
