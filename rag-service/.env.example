# ChhadKrishi knowledge-base service. Copy to rag-service/.env (local) or set as real environment
# variables (production). Locally, values in ../.env.local are also read when not set here.
# Secrets here are server-side only; never expose them to the browser.

# Shared with the Next.js server (same value as RAG_SERVICE_TOKEN in the app's .env.local).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_SERVICE_TOKEN=

# Supabase Postgres with pgvector (Project Settings -> Database -> Connection string).
# The "Session pooler" (port 5432) is best for ingestion; the transaction pooler (6543) works for queries.
SUPABASE_DB_URL=

# --- LLM for routing, rewriting, verification and answers (OpenAI-compatible) ---
# The first key set picks the provider: AI_GATEWAY_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY.
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# RAG_LLM_PROVIDER=groq            # force gateway | groq | openrouter
# RAG_LLM_MODEL=openai/gpt-oss-120b
# RAG_VISION_MODEL=qwen/qwen3.8-27b # must accept images (photo diagnosis)
# RAG_LLM_TIMEOUT_S=60

# --- Embeddings (multilingual Bangla + English) ---
# api   = qwen/qwen3-embedding-8b via AI Gateway or OpenRouter (default; same model as the chat's FAO library)
# local = sentence-transformers in-process, e.g. BAAI/bge-m3 (pip install sentence-transformers)
RAG_EMBEDDING_PROVIDER=api
# RAG_EMBEDDING_API=openrouter      # gateway | openrouter
# RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# RAG_EMBEDDING_DIMENSIONS=1024     # must stay <= 2000 for the pgvector HNSW index
# RAG_EMBEDDING_BATCH=64

# --- Retrieval and grounding ---
# RAG_RERANKER=none                 # cross-encoder = BAAI/bge-reranker-v2-m3 (needs sentence-transformers, ~2.3 GB RAM)
# RAG_TOP_K_VECTOR=30
# RAG_TOP_K_KEYWORD=30
# RAG_TOP_K_FINAL=6                 # evidence passages given to the answer
# RAG_MIN_SIMILARITY=0.45           # vector-only matches below this are dropped
# RAG_MIN_EVIDENCE=1                # verified passages needed before answering
# RAG_MAX_ATTEMPTS=2                # generation attempts before repair/abstain
# RAG_STRICT=1

# --- Operations ---
# RAG_CACHE_TTL_S=3600
# RAG_CACHE_SIZE=512
# RAG_LOG_LEVEL=INFO
# RAG_LOG_JSON=0
# OCR for scanned pages during ingestion (Tesseract binary; Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=
# RAG_OCR_LANGUAGE=eng
